<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<%- include('_head', { title: title }) %>
</head>
<body class="brand-<%= brand.name === 'Calder Savings Bank' ? 'b' : 'a' %>">
<table class="g1" cellpadding="0" cellspacing="0" border="0">
<tr>
  <td class="c1">
    <table class="g1" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="r1"><%= brand.name %> &nbsp;|&nbsp; <%= brand.product %></td></tr>
      <tr><td class="r2">Member Detail</td></tr>
    </table>
  </td>
</tr>
<tr>
  <td class="c2">

    <table class="t1" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="p1">
          <table class="t2" cellpadding="0" cellspacing="0" border="0">
            <tr><th scope="row">Member</th><td><%= member.name %></td></tr>
            <tr><th scope="row"><%= brand.idLabel %></th><td><%= member.id %></td></tr>
            <tr><th scope="row">Status</th><td><%= member.status %></td></tr>
          </table>
        </td>
      </tr>
    </table>

    <br>

    <table class="t3" cellpadding="0" cellspacing="0" border="1">
      <tr>
        <th scope="col">Account Type</th>
        <th scope="col">Number</th>
        <th scope="col">Balance</th>
      </tr>
<% member.accounts.forEach(function (row) { %>
      <tr>
        <th scope="row"><%= row.type %></th>
        <td><%= row.number %></td>
        <td><%= row.balance %></td>
      </tr>
<% }) %>
    </table>

    <br>

    <table cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="f2">
          <form method="get" action="/member/<%= member.id %>/subaccount<%= failQuery %>">
            <button class="b1" type="submit">Open Sub-Account</button>
          </form>
        </td>
        <td class="f2">&nbsp;
          <form method="get" action="/search">
            <button class="b1" type="submit">New Search</button>
          </form>
        </td>
      </tr>
    </table>

  </td>
</tr>
</table>
</body>
</html>
