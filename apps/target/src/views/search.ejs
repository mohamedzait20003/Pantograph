<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<%- include('_head', { title: title }) %>
</head>
<body class="brand-<%= brand.name === 'Calder Savings Bank' ? 'b' : 'a' %>">
<table class="g1" cellpadding="0" cellspacing="0" border="0">
<tr>
  <td class="c1">
    <table class="g1" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="r1"><%= brand.name %> &nbsp;|&nbsp; <%= brand.product %></td></tr>
      <tr><td class="r2">Member Search</td></tr>
    </table>
  </td>
</tr>
<tr>
  <td class="c2">

<% if (interstitial) { %>
    <table cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="i1">
          <table cellpadding="0" cellspacing="0" border="0">
            <tr><td class="p2"><b><%= copy.INTERSTITIAL %></b></td></tr>
            <tr><td class="p2">Take a moment to rate your experience with <%= brand.name %> Online Servicing.</td></tr>
            <tr>
              <td class="p2">
                <form method="get" action="/search">
                  <button class="b1" type="submit">Dismiss</button>
                </form>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
<% } else { %>
  <% if (error) { %>
    <table cellpadding="0" cellspacing="0" border="0">
      <tr><td class="e1"><%= error %></td></tr>
    </table>
    <br>
  <% } %>
    <table class="t1" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="p1">
          <form method="post" action="/search<%= failQuery %>">
            <table cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="f1"><label for="q7"><%= brand.idLabel %></label></td>
                <td class="f2"><input class="x1" type="text" id="q7" name="memberId" size="14" maxlength="5" value="<%= value %>"></td>
                <td class="f2">&nbsp;<button class="b1" type="submit">Search</button></td>
              </tr>
            </table>
          </form>
        </td>
      </tr>
    </table>
    <br>
    <span class="w1">Enter the 5-digit <%= brand.idLabel %>.</span>
<% } %>

  </td>
</tr>
</table>
</body>
</html>
