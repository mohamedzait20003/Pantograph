<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<%- include('_head', { title: title }) %>
</head>
<body class="brand-<%= brand.name === 'Calder Savings Bank' ? 'b' : 'a' %>">
<table class="g1" cellpadding="0" cellspacing="0" border="0">
<tr>
  <td class="c1">
    <table class="g1" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="r1"><%= brand.name %> &nbsp;|&nbsp; <%= brand.product %></td></tr>
      <tr><td class="r2">Sub-Account Confirmation</td></tr>
    </table>
  </td>
</tr>
<tr>
  <td class="c2">

    <table class="t1" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="p1">
          <table cellpadding="0" cellspacing="0" border="0">
            <tr><td class="p2"><b><%= copy.SUBACCOUNT_CREATED %></b></td></tr>
          </table>
          <table class="t2" cellpadding="0" cellspacing="0" border="0">
            <tr><th scope="row">Reference</th><td><%= reference %></td></tr>
            <tr><th scope="row">Member</th><td><%= member.name %> (<%= member.id %>)</td></tr>
            <tr><th scope="row">Sub-Account Type</th><td><%= values.type %></td></tr>
            <tr><th scope="row">Nickname</th><td><%= values.nickname %></td></tr>
            <tr><th scope="row">Initial Deposit</th><td><%= values.deposit %></td></tr>
          </table>
        </td>
      </tr>
    </table>

    <br>

    <table cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="f2">
          <form method="get" action="/member/<%= member.id %>">
            <button class="b1" type="submit">Return to Member</button>
          </form>
        </td>
        <td class="f2">&nbsp;
          <form method="get" action="/search">
            <button class="b1" type="submit">New Search</button>
          </form>
        </td>
      </tr>
    </table>

  </td>
</tr>
</table>
</body>
</html>
